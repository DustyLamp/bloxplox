{
  "name": "bloxplox",
  "version": "0.1.0",
  "private": true,
  "description": "Daily blocks, recurring habits and one-off things",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:prototype": "node scripts/serve.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:prototype": "node scripts/test.mjs",
    "test:live": "tsx tests/live/verify.mts",
    "test:e2e": "playwright test -c tests/production/playwright.config.ts",
    "test:install": "playwright install chromium webkit",
    "samples:export": "node scripts/export-samples.mjs",
    "cdk": "cdk --app \"tsx infrastructure/bin/app.ts\"",
    "synth": "yarn cdk synth",
    "deploy": "yarn cdk deploy --all --require-approval never",
    "mobile": "yarn workspace @bloxplox/mobile start",
    "typecheck:mobile": "yarn workspace @bloxplox/mobile typecheck",
    "mobile:icons": "node scripts/mobile-icons.mjs",
    "test:live:deletion": "tsx tests/live/account-deletion.mts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.0",
    "playwright": "1.64.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2",
    "xcode": "3.0.1"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*",
    "services",
    "infrastructure"
  ],
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1000.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1000.0",
    "@aws-sdk/client-cloudformation": "^3.1000.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/credential-providers": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-router": "^1.168.7",
    "@xyflow/react": "^12.12.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "aws-jwt-verify": "^5.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxdb": "17.6.0",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
